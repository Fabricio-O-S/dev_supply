# Configurações de Ambiente (Exemplo)
# ATENÇÃO: NUNCA insira senhas reais neste arquivo. Copie para .env local.

# Aplicação Flask
FLASK_APP=src/simulador_tributario.py
FLASK_ENV=development
SECRET_KEY=sua_chave_secreta_aqui_exemplo

# Banco de Dados ERP (PostgreSQL / SQL Server)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=erp_suprimentos_db
DB_USER=usuario_app
DB_PASSWORD=senha_exemplo_substituir

# Integração APIs / Webhooks (N8N)
N8N_WEBHOOK_URL=https://n8n.exemplo.com/webhook/conciliacao-nfe
